{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yammer",
  "mainBinaryName": "yammer",
  "version": "0.3.0",
  "identifier": "com.sush.yammer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Yammer",
        "width": 880,
        "height": 640,
        "minWidth": 480,
        "minHeight": 480,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1430"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5MUM2NjRBMjk1RjU1M0YKUldRL1ZWOHBTbVljR1NobDRWQ3dCUVRIWVFVb1ArbjJjcmNwQ1VRdDVhazIrZDJxL3Fwc2h0R1UK",
      "endpoints": ["https://github.com/surajS0106/yammer/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Dictate anywhere",
    "longDescription": "Hold a hotkey, speak, and Yammer pastes the transcript wherever your cursor is. Runs whisper locally or uses a cloud speech service.",
    "category": "Productivity",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libasound2"]
      }
    }
  }
}
