<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Yammer listens while you hold the dictation hotkey, to turn your speech into text.</string>
  <!-- Meeting transcripts record what the computer plays, the other side of a call
       (cpal's Core Audio process tap, macOS 14.2+). Keep the two plists in sync. -->
  <key>NSAudioCaptureUsageDescription</key>
  <string>Yammer transcribes the other side of your calls while you're taking meeting notes.</string>
  <!-- Launch without a Dock tile; dock::show adds one when the main window opens. -->
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
