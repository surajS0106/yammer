<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The light/dark icon in Assets.car (icons/build-mac-icon.sh). macOS < 26
       ignores it and keeps using CFBundleIconFile (icon.icns). -->
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <!-- Repeated from Info.plist, in case an explicit infoPlist replaces it
       rather than merging. Keep the two in sync. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Yammer listens while you hold the dictation hotkey, to turn your speech into text.</string>
  <!-- Launch without a Dock tile; dock::show adds one when the main window opens. Without this,
       macOS gives every launch a tile before any app code runs, including a second launch that
       single-instance quits at once, and the Dock kept that one as a second Yammer tile. -->
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
